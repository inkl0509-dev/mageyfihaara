rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each shop owner can only read/write their own shop data
    match /shops/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
